data/vector_store/
logs/
*.log

# Tests & docs - not needed at runtime
tests/
docs/

# Frontend chat widget - built/deployed separately
chat_widget/node_modules/
chat_widget/.next/

# OS
.DS_Store
Thumbs.db

# Misc
*.md
!README.md
