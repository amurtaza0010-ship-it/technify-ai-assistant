# ============================================
# TECHNIFY AI ASSISTANT - PHASE 2
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to Git!
# ============================================

# --------------------------------------------
# PHASE 1 - Already Existing (Keep these)
# --------------------------------------------

# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# LLM Settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# FastAPI Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ERP API Base URL (use mock for development)
ERP_API_BASE_URL=http://localhost:8001/api/v1

# JWT Settings (must match ERP's JWT config)
JWT_SECRET_KEY=your-secret-key-from-erp
JWT_ALGORITHM=HS256

# ChromaDB Settings
CHROMA_PERSIST_DIR=./data/vector_store

# Audit Log
AUDIT_LOG_FILE=./logs/audit.log

# CORS (allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --------------------------------------------
# PHASE 2 - NEW Secrets (Add these)
# --------------------------------------------

# Database Configuration (Member 1 & 2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=technify_db
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here

# Redis Configuration (Member 1)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_MEMORY=100mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_SESSION_TTL=3600
REDIS_CONVERSATION_TTL=86400

# Security & Encryption (Member 6 - Aapka)
SECRETS_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# GitHub Actions / Deployment (Member 6 - Aapka)
DEPLOY_HOST=your-server-ip-here
DEPLOY_USER=your-ssh-username-here
DEPLOY_SSH_KEY=your-ssh-private-key-here

# Additional API Keys
GOOGLE_API_KEY=your-google-api-key-here
ERP_API_KEY=your-erp-api-key-here
ERP_API_URL=https://your-erp-system.com/api

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password-here

# Redis Memory Settings (Member 1)
REDIS_NAMESPACE=technify

# ============================================
# ⚠️  REMEMBER: NEVER COMMIT .env FILE!
# ============================================